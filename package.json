{
  "name": "tornadocash-classic-ui",
  "version": "1.0.0",
  "description": "Private ethereum transactions",
  "author": "Tornado Cash Team",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "lint": "eslint --ext .js,.vue --ignore-path .gitignore .",
    "precommit": "yarn lint",
    "test": "jest",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=8192 nuxt",
    "build": "nuxt build",
    "start": "nuxt start",
    "update:zip": "node -r jiti/register scripts/updateZip.js",
    "update:events": "node -r jiti/register scripts/updateEvents.js --network",
    "update:encrypted": "node -r jiti/register scripts/updateEncryptedEvents.js --network",
    "update:governance-cache": "node -r jiti/register scripts/updateGovernanceCache.js --network",
    "update:caches": "bash scripts/updateCaches.sh",
    "update:tree": "node -r jiti/register scripts/updateTree.js --network",
    "merge:tree-cache": "node -r jiti/register scripts/mergeTreeCache.js --network",
    "generate": "cross-env NODE_OPTIONS=--max-old-space-size=8192 nuxt generate && node -e \"require('fs').copyFileSync('dist/404.html','dist/ipfs-404.html')\"",
    "ipfsUpload": "node scripts/ipfsUpload.js",
    "deploy:ipfs": "yarn generate && yarn ipfsUpload",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@apollo/client": "^3.14.1",
    "@ensdomains/ensjs": "^2.1.0",
    "@metamask/onboarding": "^1.0.1",
    "@nuxtjs/moment": "^1.6.1",
    "@walletconnect/web3-provider": "1.8.0",
    "ajv": "^8.17.1",
    "arraybuffer-loader": "^1.0.8",
    "axios": "^1.21.0",
    "base-path-converter": "^1.0.2",
    "bignumber.js": "^9.3.1",
    "bloomfilter.js": "^1.0.2",
    "circomlibjs": "^0.1.7",
    "dotenv": "^16.6.1",
    "eth-ens-namehash": "^2.0.8",
    "eth-sig-util": "^3.0.1",
    "file-saver": "^2.0.5",
    "fixed-merkle-tree": "^0.7.3",
    "form-data": "^4.0.6",
    "gas-price-oracle": "^0.5.2",
    "graphql": "^15.11.0",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.2",
    "lodash": "^4.18.1",
    "node-fetch": "^2.7.0",
    "numbro": "^2.5.0",
    "nuxt": "^2.18.1",
    "nuxt-buefy": "^0.4.29",
    "nuxt-web3-provider": "0.1.4",
    "recursive-fs": "^2.1.0",
    "snarkjs": "git+https://github.com/tornadocash/snarkjs.git#869181cfaf7526fe8972073d31655493a04326d5",
    "v-idle": "^0.2.4",
    "vue-clipboard2": "^0.3.3",
    "vue-i18n": "^8.28.2",
    "vuex-persistedstate": "^4.1.0",
    "web3": "^1.10.4",
    "websnark": "git+https://github.com/tornadocash/websnark.git#4c0af6a8b65aabea3c09f377f63c44e7a58afa6d"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/eslint-parser": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@nuxtjs/eslint-config": "^12.0.0",
    "@nuxtjs/eslint-module": "^3.1.0",
    "@vue/test-utils": "^1.3.6",
    "@vue/vue2-jest": "^29.2.6",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-nuxt": "^4.0.0",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jiti": "^1.21.7",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.10",
    "raw-loader": "^4.0.2",
    "sass": "^1.108.1",
    "sass-loader": "^10.5.2"
  },
  "resolutions": {
    "axios": "^1.21.0",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "decode-uri-component": "^0.2.2",
    "postcss": "^8.5.23",
    "serialize-javascript": "^7.1.3",
    "tar": "^7.5.21",
    "ws": "^8.21.0",
    "tmp": "^0.2.6",
    "form-data": "^4.0.6",
    "cookie": "^0.7.2",
    "flatted": "^3.4.2",
    "yargs-parser": "^21.1.1",
    "**/levelup/semver": "^5.7.2",
    "**/request/qs": "^6.16.0",
    "**/request/tough-cookie": "^4.1.3",
    "**/web3-eth-accounts/uuid": "^11.1.1",
    "**/ethjs-unit/bn.js": "^4.12.3",
    "**/number-to-bn/bn.js": "^4.12.3",
    "**/@walletconnect/utils/bn.js": "^4.12.3",
    "**/js-beautify/glob": "^14.0.2",
    "**/editorconfig/minimatch": "^11.0.1",
    "devalue": "^5.9.3",
    "defu": "^6.1.7"
  }
}
